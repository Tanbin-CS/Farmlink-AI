# Copy to .env for local development. Never commit real values.
APP_ENV=development
PORT=8080
# Exact browser origins allowed by CORS (scheme + host + port, no path). Comma separated.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Postgres connection string (Neon / Render Postgres). Empty = in-memory store (NOT durable, dev only).
DATABASE_URL=
# Live model calls are disabled unless this is exactly "true" AND a key + model are configured.
LIVE_AI_ENABLED=false
MODEL_PROVIDER=gemini
# Use a model ID that your account can actually access (check Google AI Studio). Not hardcoded.
MODEL_ID=
# Secret. Set in the hosting provider's secret/env settings only.
GEMINI_API_KEY=
# Server-enforced limits (design defaults, adjustable)
SESSION_TTL_MINUTES=120
SESSIONS_PER_HOUR_GLOBAL=200
AGENT_RUNS_PER_SESSION_PER_HOUR=10
PROVIDER_CALLS_PER_DAY_GLOBAL=300
MAX_ROUND_TRIPS=3
MAX_TOOL_CALLS=6
PROVIDER_TIMEOUT_MS=25000
ACTION_TTL_SECONDS=300

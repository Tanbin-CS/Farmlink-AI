# Public build-time values only. Anything prefixed VITE_ is embedded in the public JavaScript bundle.
# Never put API keys or secrets here.
VITE_BASE_PATH=/
# Optional: the live API origin (for example https://farmlink-api.onrender.com). Leave empty for guided mode only.
VITE_API_BASE_URL=
VITE_BUILD_SHA=local
VITE_REPO_URL=https://github.com/Tanbin-CS/Farmlink-AI

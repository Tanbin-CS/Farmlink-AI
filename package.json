{
  "name": "farmlink-ai",
  "private": true,
  "version": "0.1.0",
  "description": "FarmLink AI - sandbox SME finance copilot for agricultural cooperatives (FinTechathon 2026, Topic E)",
  "workspaces": [
    "packages/engine",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w frontend && npm run build -w backend",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
